+bool CPDF_StreamParser::TryReadTextArray(
+    std::vector<ByteString>& strings,
+    std::vector<float>& kernings,
+    float& initial_kerning) {
+  const uint32_t saved = pos_;
+  auto fail = [&]() {
+    pos_ = saved;
+    strings.clear();
+    kernings.clear();
+    return false;
+  };
+  strings.clear();
+  kernings.clear();
+  initial_kerning = 0;
+  while (PositionIsInBounds() && PDFCharIsWhitespace(buf_[pos_])) {
+    ++pos_;
+  }
+  if (!PositionIsInBounds() || buf_[pos_] != '[') {
+    return fail();
+  }
+  ++pos_;
+  size_t total_strings = 0;
+  while (true) {
+    const uint32_t item_start = pos_;
+    bool number = false;
+    GetNextWord(number);
+    if (!word_size_) {
+      return fail();
+    }
+    if (number) {
+      word_buffer_[word_size_] = 0;
+      const float value = FX_Number(GetWord()).GetFloat();
+      if (strings.empty()) {
+        initial_kerning += value;
+      } else {
+        kernings.back() += value;
+      }
+      continue;
+    }
+    if (GetWord() == "]") {
+      break;
+    }
+    if (word_buffer_[0] != '(' &&
+        !(word_buffer_[0] == '<' && word_size_ == 1)) {
+      return fail();
+    }
+    pos_ = item_start;
+    RetainPtr<CPDF_Object> object = ReadNextObject(false, true, 1);
+    if (!object || !object->IsString()) {
+      return fail();
+    }
+    ++total_strings;
+    ByteString value = object->GetString();
+    if (!value.IsEmpty()) {
+      strings.push_back(std::move(value));
+      kernings.push_back(0);
+    }
+  }
+  // All-number arrays retain the original individual position updates.
+  if (!total_strings) {
+    return fail();
+  }
+  bool number = false;
+  GetNextWord(number);
+  if (number || GetWord() != "TJ") {
+    return fail();
+  }
+  // Match the original handler's zero padding for empty string objects.
+  kernings.resize(total_strings, 0);
+  return true;
+}
