{
  "name": "default",
  "adapters": {
    "html": {
      "hide_hidden_attr": false,
      "hide_visibility": false,
      "max_span": 100
    },
    "text": {
      "tab_size": 8
    },
    "partialsgml": {
      "tab_size": 8
    },
    "pdf": {
      "clip_to_page": false,
      "detect_decorations": false,
      "layout": "default",
      "font_recovery": "default"
    },
    "bb": {
      "word_gap_height_ratio": 0.9,
      "table_header_gap_height_ratio": 2.5,
      "reject_prose_tables": false,
      "prose_min_letters": 20,
      "prose_min_words": 4,
      "prose_min_lines": 2,
      "prose_min_width_heights": 8,
      "prose_min_mixed_case_fraction": 0.5,
      "protect_compact_codes": true,
      "code_max_words": 3,
      "code_max_width_heights": 6,
      "code_min_rows": 3,
      "code_min_fraction": 0.5,
      "protect_repeated_entries": true,
      "repeat_min_count": 2,
      "repeat_min_fraction": 0.5,
      "merge_table_headers": false,
      "protect_table_section_labels": false,
      "table_lookahead": 8,
      "table_min_column_rows": 1,
      "table_header_rows": 6,
      "table_continuation_gap": 0.6,
      "continuation_font_tolerance": 0.0,
      "table_extension_min_fraction": 0.8
    }
  },
  "headers": [],
  "header_styles": [
    "bold",
    "all_caps",
    "proper_case"
  ],
  "remove": {
    "linked_regions": [],
    "patterns": [
      [
        "^\\d+$",
        false
      ],
      [
        "^-\\d+-$",
        false
      ],
      [
        "(^\\s*\\d+\\s*\\||\\|\\s*\\d+\\s*$)",
        false
      ],
      [
        "^_+$",
        false
      ],
      [
        "^●(?:\\s*●)*$",
        false
      ],
      [
        "^table\\s+of\\s+contents$",
        true
      ]
    ],
    "repeat_threshold": 20,
    "page_label_regex": "^f-\\d{1,4}$"
  },
  "tables": {
    "steps": [
      "validate_structure",
      "merge_formatting_chars",
      "remove_empty_rows",
      "remove_empty_columns",
      "remove_subset_rows_bottom_to_top",
      "remove_subset_rows_top_to_bottom",
      "remove_subset_columns_left_to_right",
      "remove_subset_columns_right_to_left",
      "merge_duplicate_header_rows_down"
    ],
    "single_row_to_text": true,
    "title_from_section": true,
    "footnote_regex": "^(\\*+|\\((?:[a-zA-Z]|\\d{1,3}|[ivxlcdmIVXLCDM]{2,4})\\)|\\d{1,3}(?:[.)](?!\\d)|(?=\\s|$))|†+)",
    "annotation_exclude_regex": "(?i)^(?:\\(\\d{3}\\)\\s*\\d{3}[-.\\s]\\d{4}|[1-9]\\d{2,4}\\s+(?:[\\w.\\x27-]+\\s+){1,5}(?:street|avenue|road|boulevard|drive|lane|way|st\\.?|ave\\.?|rd\\.?|blvd\\.?)\\b)",
    "footnote_lines": 3,
    "preamble_lines": 7,
    "postamble_lines": 7,
    "unwrap_layout": false,
    "protect_years": true,
    "formatting_max_gap": -1
  },
  "lists": {
    "max_gap_rows": 3,
    "max_tail_rows": 1
  },
  "columns": [],
  "text": {
    "preserve_styles": [],
    "join_wrapped_lines": false,
    "protect_wrapped_headings": false,
    "token_normalizations": [],
    "merge_adjacent": true,
    "wrap_hyphenation": "preserve"
  },
  "headings": {
    "recognize_inferred": false,
    "split_before": [],
    "infer": true,
    "use_font_size": true,
    "styles": [
      "bold",
      "italic",
      "underline",
      "centered",
      "all_caps",
      "proper_case"
    ],
    "max_words": 0,
    "merge_adjacent": true
  }
}
