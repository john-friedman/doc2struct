{
  "namespace": "BB",
  "rule_sets": {
    "bb_parsebench": {
      "name": "bb_parsebench",
      "text": {
        "preserve_styles": [
          "bold",
          "italic",
          "underline",
          "strikethrough"
        ],
        "join_wrapped_lines": true,
        "wrap_hyphenation": "preserve"
      },
      "headings": {
        "infer": true,
        "styles": [
          "bold",
          "all_caps",
          "proper_case"
        ],
        "max_words": 30,
        "merge_adjacent": false
      },
      "headers": [],
      "tables": {
        "steps": [
          "validate_structure",
          "merge_formatting_chars",
          "remove_empty_rows",
          "remove_empty_columns",
          "remove_subset_rows_bottom_to_top",
          "remove_subset_rows_top_to_bottom",
          "remove_subset_columns_left_to_right",
          "remove_subset_columns_right_to_left"
        ],
        "protect_years": true,
        "formatting_max_gap": 8
      }
    }
  },
  "document_types": {
    "PARSEBENCH": "bb_parsebench"
  }
}
